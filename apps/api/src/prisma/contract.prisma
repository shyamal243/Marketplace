// use prisma-next
model User {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique
  password             String
  name                 String
  role                 String               @default("buyer") // "buyer", "seller", "admin", "delivery", "worker"
  demands              Demand[]
  bids                 Bid[]
  ordersAsBuyer        Order[]              @relation("OrderBuyer")
  ordersAsSeller       Order[]              @relation("OrderSeller")
  reviewsGiven         Review[]             @relation("ReviewsGiven")
  reviewsReceived      Review[]             @relation("ReviewsReceived")
  notifications        Notification[]
  walletBalance        Int                  @default(0)
  walletTxns           WalletTransaction[]
  stores               Store[]
  productRatings       ProductRating[]
  passwordResets       PasswordResetToken[]
  deliveryAssignments  DeliveryAssignment[]
  returnRequests       ReturnRequest[]
  deliveryRatingsGiven DeliveryRating[]
  tipsGiven            DeliveryTip[]        @relation("TipsGiven")
  tipsReceived         DeliveryTip[]        @relation("TipsReceived")
  kycDocuments         KycDocument[]
  kycStatus            String               @default("not_submitted") // "not_submitted", "pending", "approved", "rejected"

  createdAt            TimestamptzString    @default(now())
  updatedAt            TimestamptzString    @default(now())
}

model Demand {
  id                 Int                @id @default(autoincrement())
  title              String
  category           String?
  description        String?
  budget             Int?
  hoursNeeded        Int?
  status             String             @default("open") // "pending_payment", "open", "closed", "fulfilled"
  bookingFeeAmount   Int?
  bookingFeePaid     Boolean            @default(false)
  bidWindowExpiresAt TimestamptzString?
  buyer              User               @relation(fields:[buyerId], references:[id])
  buyerId            Int
  bids               Bid[]
  orders             Order[]
  createdAt          TimestamptzString  @default(now())
  updatedAt          TimestamptzString  @default(now())
}

model Bid {
  id        Int               @id @default(autoincrement())
  amount    Int
  message   String?
  status    String            @default("pending") // "pending", "accepted", "rejected"
  demand    Demand            @relation(fields:[demandId], references:[id])
  demandId  Int
  seller    User              @relation(fields:[sellerId], references:[id])
  sellerId  Int
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
}

model Order {
  id                 Int                 @id @default(autoincrement())
  amount             Int
  status             String              @default("confirmed") // "confirmed", "shipped", "delivered", "cancelled"
  isPaid             Boolean             @default(false)
  orderType          String              @default("bid_order") // "bid_order" or "store_order"
  demand             Demand?             @relation(fields:[demandId], references:[id])
  demandId           Int?
  bid                Bid?                @relation(fields:[bidId], references:[id])
  bidId              Int?
  store              Store?              @relation(fields:[storeId], references:[id])
  storeId            Int?
  items              OrderItem[]
  buyer              User                @relation("OrderBuyer", fields:[buyerId], references:[id])
  buyerId            Int
  seller             User                @relation("OrderSeller", fields:[sellerId], references:[id])
  sellerId           Int
  deliveryMode       String? // "local" or "courier"
  trackingNumber     String?
  courierName        String?
  gstCategory        String?
  gstRatePercent     Int?
  gstAmount          Int?
  commissionAmount   Int?
  deliveryFeeAmount  Int?
  deliveryAssignment DeliveryAssignment?
  returnRequest      ReturnRequest?
  review             Review[]
  createdAt          TimestamptzString   @default(now())
  updatedAt          TimestamptzString   @default(now())
}

model Review {
  id         Int               @id @default(autoincrement())
  rating     Int
  comment    String?
  order      Order             @relation(fields:[orderId], references:[id])
  orderId    Int
  reviewer   User              @relation("ReviewsGiven", fields:[reviewerId], references:[id])
  reviewerId Int
  reviewee   User              @relation("ReviewsReceived", fields:[revieweeId], references:[id])
  revieweeId Int
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@unique([orderId, reviewerId])
}

model Notification {
  id        Int               @id @default(autoincrement())
  message   String
  type      String // "new_bid", "bid_accepted", "bid_rejected", "order_shipped", "order_delivered"
  isRead    Boolean           @default(false)
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  createdAt TimestamptzString @default(now())
}

model PlatformSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model WalletTransaction {
  id        Int               @id @default(autoincrement())
  amount    Int
  type      String // "credit" or "debit"
  reason    String // "topup", "booking_fee", "booking_fee_refund", "order_payment", "admin_adjustment"
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  createdAt TimestamptzString @default(now())
}

model Product {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  price       Int
  stock       Int               @default(0)
  isActive    Boolean           @default(true)
  store       Store             @relation(fields:[storeId], references:[id])
  storeId     Int
  orderItems  OrderItem[]
  ratings     ProductRating[]
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())
}

model ProductRating {
  id         Int               @id @default(autoincrement())
  rating     Int
  comment    String?
  product    Product           @relation(fields:[productId], references:[id])
  productId  Int
  customer   User              @relation(fields:[customerId], references:[id])
  customerId Int
  createdAt  TimestamptzString @default(now())

  @@unique([productId, customerId])
}

model BlockedToken {
  id        Int               @id @default(autoincrement())
  token     String            @unique
  createdAt TimestamptzString @default(now())
}

model PasswordResetToken {
  id        Int               @id @default(autoincrement())
  token     String            @unique
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  expiresAt TimestamptzString
  used      Boolean           @default(false)
  createdAt TimestamptzString @default(now())
}

model ProcessedPayment {
  id                Int               @id @default(autoincrement())
  razorpayPaymentId String            @unique
  createdAt         TimestamptzString @default(now())
}

model DeliveryAssignment {
  id               Int               @id @default(autoincrement())
  order            Order             @relation(fields:[orderId], references:[id])
  orderId          Int               @unique
  deliveryPerson   User              @relation(fields:[deliveryPersonId], references:[id])
  deliveryPersonId Int
  status           String            @default("assigned") // "assigned", "picked_up", "out_for_delivery", "delivered"
  rating           DeliveryRating?
  tip              DeliveryTip?
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())
}

model ReturnRequest {
  id            Int               @id @default(autoincrement())
  order         Order             @relation(fields:[orderId], references:[id])
  orderId       Int               @unique
  reason        String
  status        String            @default("requested") // "requested", "approved", "rejected", "completed"
  requestedBy   User              @relation(fields:[requestedById], references:[id])
  requestedById Int
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())
}

model GstRate {
  id          Int    @id @default(autoincrement())
  category    String @unique
  ratePercent Int
}

model DeliveryRating {
  id                   Int                @id @default(autoincrement())
  rating               Int
  comment              String?
  deliveryAssignment   DeliveryAssignment @relation(fields:[deliveryAssignmentId], references:[id])
  deliveryAssignmentId Int                @unique
  customer             User               @relation(fields:[customerId], references:[id])
  customerId           Int
  createdAt            TimestamptzString  @default(now())
}

model DeliveryTip {
  id                   Int                @id @default(autoincrement())
  amount               Int
  deliveryAssignment   DeliveryAssignment @relation(fields:[deliveryAssignmentId], references:[id])
  deliveryAssignmentId Int                @unique
  customer             User               @relation("TipsGiven", fields:[customerId], references:[id])
  customerId           Int
  deliveryPerson       User               @relation("TipsReceived", fields:[deliveryPersonId], references:[id])
  deliveryPersonId     Int
  createdAt            TimestamptzString  @default(now())
}

model Store {
  id               Int               @id @default(autoincrement())
  seller           User              @relation(fields:[sellerId], references:[id])
  sellerId         Int
  name             String
  address          String?
  latitude         Float?
  longitude        Float?
  deliveryFeeBase  Int               @default(0)
  deliveryFeePerKm Int               @default(0)
  isActive         Boolean           @default(true)
  products         Product[]
  orders           Order[]
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  order           Order   @relation(fields:[orderId], references:[id])
  orderId         Int
  product         Product @relation(fields:[productId], references:[id])
  productId       Int
  quantity        Int
  priceAtPurchase Int
}

model KycDocument {
  id              Int               @id @default(autoincrement())
  documentType    String // "aadhaar", "pan", "bank_account", "photo"
  documentNumber  String?
  fileUrl         String?
  status          String            @default("pending") // "pending", "approved", "rejected"
  rejectionReason String?
  user            User              @relation(fields:[userId], references:[id])
  userId          Int
  createdAt       TimestamptzString @default(now())
  updatedAt       TimestamptzString @default(now())
}

model PlatformEarning {
  id        Int               @id @default(autoincrement())
  type      String // "commission", "booking_fee_forfeit"
  amount    Int
  orderId   Int?
  demandId  Int?
  createdAt TimestamptzString @default(now())
}
