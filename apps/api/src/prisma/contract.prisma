// use prisma-next
model User {
  id                     Int                  @id @default(autoincrement())
  email                  String               @unique
  password               String
  name                   String
  phone                  String?
  address                String?
  city                   String?
  role                   String               @default("buyer") // "buyer", "seller", "admin", "delivery", "professional"
  demands                Demand[]
  bids                   Bid[]
  ordersAsBuyer          Order[]              @relation("OrderBuyer")
  ordersAsSeller         Order[]              @relation("OrderSeller")
  reviewsGiven           Review[]             @relation("ReviewsGiven")
  reviewsReceived        Review[]             @relation("ReviewsReceived")
  notifications          Notification[]
  walletBalance          Int                  @default(0)
  walletTxns             WalletTransaction[]
  stores                 Store[]
  productRatings         ProductRating[]
  passwordResets         PasswordResetToken[]
  deliveryAssignments    DeliveryAssignment[]
  returnRequests         ReturnRequest[]
  deliveryRatingsGiven   DeliveryRating[]
  tipsGiven              DeliveryTip[]        @relation("TipsGiven")
  tipsReceived           DeliveryTip[]        @relation("TipsReceived")
  kycDocuments           KycDocument[]
  kycStatus              String               @default("not_submitted") // "not_submitted", "pending", "approved", "rejected"
  isAvailableForDelivery Boolean              @default(false)
  currentLatitude        Float?
  currentLongitude       Float?
  favorites              Favorite[]
  couponRedemptions      CouponRedemption[]
  professionalSkills     ProfessionalSkill[]
  storeAccesses          StoreAccess[]
  assignedTasks          Task[]               @relation("AssignedTasks")
  createdTasks           Task[]               @relation("CreatedTasks")
  referralCode           String?              @unique
  referredBy             Int?
  referralRewarded       Boolean              @default(false)

  createdAt              TimestamptzString    @default(now())
  updatedAt              TimestamptzString    @default(now())
}

model Demand {
  id                 Int                @id @default(autoincrement())
  title              String
  category           String?
  deliveryAddress    String?
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  description        String?
  budget             Int?
  hoursNeeded        Int?
  status             String             @default("open") // "pending_payment", "open", "closed", "fulfilled"
  bookingFeeAmount   Int?
  bookingFeePaid     Boolean            @default(false)
  bidWindowExpiresAt TimestamptzString?
  buyer              User               @relation(fields:[buyerId], references:[id])
  buyerId            Int
  bids               Bid[]
  orders             Order[]
  createdAt          TimestamptzString  @default(now())
  updatedAt          TimestamptzString  @default(now())
}

model Bid {
  id              Int               @id @default(autoincrement())
  amount          Int
  message         String?
  status          String            @default("pending") // "pending", "accepted", "rejected"
  demand          Demand            @relation(fields:[demandId], references:[id])
  demandId        Int
  seller          User              @relation(fields:[sellerId], references:[id])
  sellerId        Int
  linkedProduct   Product?          @relation(fields:[linkedProductId], references:[id])
  linkedProductId Int?
  createdAt       TimestamptzString @default(now())
  updatedAt       TimestamptzString @default(now())
}

model Order {
  id                       Int                 @id @default(autoincrement())
  amount                   Int
  status                   String              @default("confirmed") // "confirmed", "shipped", "delivered", "cancelled"
  isPaid                   Boolean             @default(false)
  otpRequired              Boolean             @default(false)
  professionalSkillId      Int?
  scheduleType             String? // "instant", "today", "tomorrow", "weekly", "monthly"
  scheduledFor             TimestamptzString?
  hoursBooked              Int?
  vehicleType              String? // "2w", "3w", "4w"
  isFreight                Boolean             @default(false)
  weightKg                 Float?
  sizeCategory             String? // "small", "medium", "large"
  pages                    Int?
  copies                   Int?
  isColorPrint             Boolean             @default(false)
  printFilePath            String?
  rentalHours              Int?
  rentalStartOtp           String?
  rentalStartOtpVerifiedAt TimestamptzString?
  rentalEndOtp             String?
  rentalEndOtpVerifiedAt   TimestamptzString?
  pickupLatitude           Float?
  pickupLongitude          Float?
  pickupAddress            String?
  dropLatitude             Float?
  dropLongitude            Float?
  dropAddress              String?
  rideOtp                  String?
  rideOtpVerifiedAt        TimestamptzString?
  checkoutOtp              String?
  checkoutOtpVerifiedAt    TimestamptzString?
  deliveryOtp              String?
  deliveryOtpVerifiedAt    TimestamptzString?
  orderType                String              @default("bid_order") // "bid_order" or "store_order"
  demand                   Demand?             @relation(fields:[demandId], references:[id])
  demandId                 Int?
  bid                      Bid?                @relation(fields:[bidId], references:[id])
  bidId                    Int?
  store                    Store?              @relation(fields:[storeId], references:[id])
  storeId                  Int?
  items                    OrderItem[]
  buyer                    User                @relation("OrderBuyer", fields:[buyerId], references:[id])
  buyerId                  Int
  seller                   User                @relation("OrderSeller", fields:[sellerId], references:[id])
  sellerId                 Int
  deliveryMode             String? // "local" or "courier"
  trackingNumber           String?
  courierName              String?
  gstCategory              String?
  gstRatePercent           Int?
  gstAmount                Int?
  commissionAmount         Int?
  deliveryFeeAmount        Int?
  deliveryAssignment       DeliveryAssignment?
  returnRequest            ReturnRequest?
  gstInvoice               GstInvoice?
  review                   Review[]
  createdAt                TimestamptzString   @default(now())
  updatedAt                TimestamptzString   @default(now())
}

model Review {
  id         Int               @id @default(autoincrement())
  rating     Int
  comment    String?
  order      Order             @relation(fields:[orderId], references:[id])
  orderId    Int
  reviewer   User              @relation("ReviewsGiven", fields:[reviewerId], references:[id])
  reviewerId Int
  reviewee   User              @relation("ReviewsReceived", fields:[revieweeId], references:[id])
  revieweeId Int
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@unique([orderId, reviewerId])
}

model Notification {
  id        Int               @id @default(autoincrement())
  message   String
  type      String // "new_bid", "bid_accepted", "bid_rejected", "order_shipped", "order_delivered"
  isRead    Boolean           @default(false)
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  createdAt TimestamptzString @default(now())
}

model PlatformSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model WalletTransaction {
  id        Int               @id @default(autoincrement())
  amount    Int
  type      String // "credit" or "debit"
  reason    String // "topup", "booking_fee", "booking_fee_refund", "order_payment", "admin_adjustment"
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  createdAt TimestamptzString @default(now())
}

model Product {
  id           Int               @id @default(autoincrement())
  name         String
  description  String?
  category     String?
  price        Int
  stock        Int               @default(0)
  isActive     Boolean           @default(true)
  store        Store             @relation(fields:[storeId], references:[id])
  storeId      Int
  orderItems   OrderItem[]
  favoritedBy  Favorite[]
  ratings      ProductRating[]
  linkedInBids Bid[]
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())
}

model ProductRating {
  id         Int               @id @default(autoincrement())
  rating     Int
  comment    String?
  product    Product           @relation(fields:[productId], references:[id])
  productId  Int
  customer   User              @relation(fields:[customerId], references:[id])
  customerId Int
  createdAt  TimestamptzString @default(now())

  @@unique([productId, customerId])
}

model BlockedToken {
  id        Int               @id @default(autoincrement())
  token     String            @unique
  createdAt TimestamptzString @default(now())
}

model PasswordResetToken {
  id        Int               @id @default(autoincrement())
  token     String            @unique
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  expiresAt TimestamptzString
  used      Boolean           @default(false)
  createdAt TimestamptzString @default(now())
}

model ProcessedPayment {
  id                Int               @id @default(autoincrement())
  razorpayPaymentId String            @unique
  createdAt         TimestamptzString @default(now())
}

model DeliveryAssignment {
  id               Int               @id @default(autoincrement())
  order            Order             @relation(fields:[orderId], references:[id])
  orderId          Int               @unique
  deliveryPerson   User              @relation(fields:[deliveryPersonId], references:[id])
  deliveryPersonId Int
  status           String            @default("assigned") // "assigned", "picked_up", "out_for_delivery", "delivered"
  rating           DeliveryRating?
  tip              DeliveryTip?
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())
}

model ReturnRequest {
  id            Int               @id @default(autoincrement())
  order         Order             @relation(fields:[orderId], references:[id])
  orderId       Int               @unique
  reason        String
  status        String            @default("requested") // "requested", "approved", "rejected", "completed"
  requestedBy   User              @relation(fields:[requestedById], references:[id])
  requestedById Int
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())
}

model GstRate {
  id          Int    @id @default(autoincrement())
  category    String @unique
  ratePercent Int
}

model DeliveryRating {
  id                   Int                @id @default(autoincrement())
  rating               Int
  comment              String?
  deliveryAssignment   DeliveryAssignment @relation(fields:[deliveryAssignmentId], references:[id])
  deliveryAssignmentId Int                @unique
  customer             User               @relation(fields:[customerId], references:[id])
  customerId           Int
  createdAt            TimestamptzString  @default(now())
}

model DeliveryTip {
  id                   Int                @id @default(autoincrement())
  amount               Int
  deliveryAssignment   DeliveryAssignment @relation(fields:[deliveryAssignmentId], references:[id])
  deliveryAssignmentId Int                @unique
  customer             User               @relation("TipsGiven", fields:[customerId], references:[id])
  customerId           Int
  deliveryPerson       User               @relation("TipsReceived", fields:[deliveryPersonId], references:[id])
  deliveryPersonId     Int
  createdAt            TimestamptzString  @default(now())
}

model Store {
  id                         Int               @id @default(autoincrement())
  seller                     User              @relation(fields:[sellerId], references:[id])
  sellerId                   Int
  name                       String
  address                    String?
  latitude                   Float?
  longitude                  Float?
  deliveryFeeBase            Int               @default(0)
  deliveryFeePerKm           Int               @default(0)
  offersPrintService         Boolean           @default(false)
  storeAccesses              StoreAccess[]
  hygienePhotos              HygienePhoto[]
  printPricePerPageBw        Int?
  printPricePerPageColor     Int?
  fssaiLicenseNumber         String?
  businessRegistrationNumber String?
  isActive                   Boolean           @default(true)
  products                   Product[]
  orders                     Order[]
  favoritedBy                Favorite[]
  createdAt                  TimestamptzString @default(now())
  updatedAt                  TimestamptzString @default(now())
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  order           Order   @relation(fields:[orderId], references:[id])
  orderId         Int
  product         Product @relation(fields:[productId], references:[id])
  productId       Int
  quantity        Int
  priceAtPurchase Int
}

model KycDocument {
  id              Int               @id @default(autoincrement())
  documentType    String // "aadhaar", "pan", "bank_account", "photo"
  documentNumber  String?
  fileUrl         String?
  status          String            @default("pending") // "pending", "approved", "rejected"
  rejectionReason String?
  user            User              @relation(fields:[userId], references:[id])
  userId          Int
  createdAt       TimestamptzString @default(now())
  updatedAt       TimestamptzString @default(now())
}

model PlatformEarning {
  id        Int               @id @default(autoincrement())
  type      String // "commission", "booking_fee_forfeit"
  amount    Int
  orderId   Int?
  demandId  Int?
  createdAt TimestamptzString @default(now())
}

model GstInvoice {
  id            Int               @id @default(autoincrement())
  order         Order             @relation(fields:[orderId], references:[id])
  orderId       Int               @unique
  invoiceNumber String            @unique
  buyerGstin    String?
  baseAmount    Int
  gstAmount     Int
  totalAmount   Int
  createdAt     TimestamptzString @default(now())
}

model Favorite {
  id        Int               @id @default(autoincrement())
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  store     Store?            @relation(fields:[storeId], references:[id])
  storeId   Int?
  product   Product?          @relation(fields:[productId], references:[id])
  productId Int?
  createdAt TimestamptzString @default(now())

  @@unique([userId, storeId, productId])
}

model RazorpayOrderMapping {
  id              Int               @id @default(autoincrement())
  razorpayOrderId String            @unique
  purpose         String // "order_payment", "wallet_topup", "booking_fee"
  referenceId     Int
  userId          Int
  amount          Int
  createdAt       TimestamptzString @default(now())
}

model ProfessionalSkill {
  id             Int               @id @default(autoincrement())
  professional   User              @relation(fields:[professionalId], references:[id])
  professionalId Int
  skillName      String
  category       String?
  hourlyRate     Int
  isActive       Boolean           @default(true)
  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())
}

model StoreAccess {
  id                 Int               @id @default(autoincrement())
  store              Store             @relation(fields:[storeId], references:[id])
  storeId            Int
  coSupplier         User              @relation(fields:[userId], references:[id])
  userId             Int
  assignedBySellerId Int
  createdAt          TimestamptzString @default(now())
}

model Task {
  id               Int               @id @default(autoincrement())
  assignedTo       User              @relation("AssignedTasks", fields:[assignedToId], references:[id])
  assignedToId     Int
  createdByAdmin   User              @relation("CreatedTasks", fields:[createdByAdminId], references:[id])
  createdByAdminId Int
  taskType         String
  relatedUserId    Int?
  title            String
  description      String?
  status           String            @default("pending")
  notes            String?
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())
}

model Coupon {
  id             Int                @id @default(autoincrement())
  code           String             @unique
  description    String?
  rewardType     String // "discount" or "cashback"
  valueType      String // "flat" or "percent"
  value          Int
  maxDiscount    Int?
  minOrderAmount Int?
  usageLimit     Int?
  usedCount      Int                @default(0)
  perUserLimit   Int?               @default(1)
  isActive       Boolean            @default(true)
  expiresAt      TimestamptzString?
  redemptions    CouponRedemption[]
  createdAt      TimestamptzString  @default(now())
}

model CouponRedemption {
  id        Int               @id @default(autoincrement())
  coupon    Coupon            @relation(fields:[couponId], references:[id])
  couponId  Int
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  orderId   Int
  amount    Int
  createdAt TimestamptzString @default(now())
}

model HygienePhoto {
  id         Int               @id @default(autoincrement())
  store      Store             @relation(fields:[storeId], references:[id])
  storeId    Int
  photoPath  String
  uploadedAt TimestamptzString @default(now())
}

model RiskFlag {
  id         Int               @id @default(autoincrement())
  entityType String // "user" or "order"
  entityId   Int
  reason     String
  severity   String // "low", "medium", "high"
  resolved   Boolean           @default(false)
  createdAt  TimestamptzString @default(now())
}

model DataRequest {
  id          Int                @id @default(autoincrement())
  userId      Int
  type        String // "export" or "deletion"
  status      String             @default("pending") // "pending", "completed", "rejected"
  notes       String?
  requestedAt TimestamptzString  @default(now())
  completedAt TimestamptzString?
}
