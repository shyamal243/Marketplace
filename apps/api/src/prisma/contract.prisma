// use prisma-next
model User {
  id              Int               @id @default(autoincrement())
  email           String            @unique
  password        String
  name            String
  role            String            @default("buyer") // "buyer" or "seller"
  demands         Demand[]
  bids            Bid[]
  ordersAsBuyer   Order[]           @relation("OrderBuyer")
  ordersAsSeller  Order[]           @relation("OrderSeller")
  reviewsGiven    Review[]          @relation("ReviewsGiven")
  reviewsReceived Review[]          @relation("ReviewsReceived")
  notifications   Notification[]

  createdAt       TimestamptzString @default(now())
  updatedAt       TimestamptzString @default(now())
}

model Demand {
  id          Int               @id @default(autoincrement())
  title       String
  description String?
  budget      Int?
  status      String            @default("open") // "open", "closed", "fulfilled"
  buyer       User              @relation(fields:[buyerId], references:[id])
  buyerId     Int
  bids        Bid[]
  orders      Order[]
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())
}

model Bid {
  id        Int               @id @default(autoincrement())
  amount    Int
  message   String?
  status    String            @default("pending") // "pending", "accepted", "rejected"
  demand    Demand            @relation(fields:[demandId], references:[id])
  demandId  Int
  seller    User              @relation(fields:[sellerId], references:[id])
  sellerId  Int
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
}

model Order {
  id        Int               @id @default(autoincrement())
  amount    Int
  status    String            @default("confirmed") // "confirmed", "shipped", "delivered", "cancelled", "paid"
  demand    Demand            @relation(fields:[demandId], references:[id])
  demandId  Int
  bid       Bid               @relation(fields:[bidId], references:[id])
  bidId     Int
  buyer     User              @relation("OrderBuyer", fields:[buyerId], references:[id])
  buyerId   Int
  seller    User              @relation("OrderSeller", fields:[sellerId], references:[id])
  sellerId  Int
  review    Review?
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
}

model Review {
  id         Int               @id @default(autoincrement())
  rating     Int
  comment    String?
  order      Order             @relation(fields:[orderId], references:[id])
  orderId    Int               @unique
  reviewer   User              @relation("ReviewsGiven", fields:[reviewerId], references:[id])
  reviewerId Int
  reviewee   User              @relation("ReviewsReceived", fields:[revieweeId], references:[id])
  revieweeId Int
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())
}

model Notification {
  id        Int               @id @default(autoincrement())
  message   String
  type      String // "new_bid", "bid_accepted", "bid_rejected", "order_shipped", "order_delivered"
  isRead    Boolean           @default(false)
  user      User              @relation(fields:[userId], references:[id])
  userId    Int
  createdAt TimestamptzString @default(now())
}
